{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NexoTV",
  "version": "0.1.0",
  "identifier": "com.nexotv.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexoTV",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#061433"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
